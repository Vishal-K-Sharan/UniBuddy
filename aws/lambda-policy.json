{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBWorkspace",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:ACCOUNT_ID:table/UniBuddyData"
    },
    {
      "Sid": "BedrockNovaInference",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:GetInferenceProfile"
      ],
      "Resource": "*"
    }
  ]
}
